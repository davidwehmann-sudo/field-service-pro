{
  "name": "PartVerification",
  "type": "object",
  "properties": {
    "part_number": {
      "type": "string",
      "description": "Part number this verification applies to"
    },
    "manufacturer": {
      "type": "string",
      "description": "Part manufacturer (e.g., Caterpillar, John Deere, OEM)"
    },
    "source_name": {
      "type": "string",
      "description": "Name of verification source (e.g., 'Caterpillar SIS', 'John Deere Service Advisor', 'OEM Manual')"
    },
    "source_details": {
      "type": "string",
      "description": "Specific reference (page number, section, digital link, diagram number)"
    },
    "photo_url": {
      "type": "string",
      "description": "Photo/screenshot of parts book, diagram, or manual showing specification"
    },
    "machine_model": {
      "type": "string",
      "description": "Machine model this verification applies to (e.g., 'CAT 416E', 'JD 310K')"
    },
    "part_description": {
      "type": "string",
      "description": "Description of the part from the verification source"
    },
    "technician_notes": {
      "type": "string",
      "description": "Any specific context or notes from the technician"
    },
    "service_company": {
      "type": "string",
      "description": "Which service company this verification belongs to"
    }
  },
  "required": [
    "part_number",
    "source_name",
    "source_details",
    "machine_model"
  ]
}