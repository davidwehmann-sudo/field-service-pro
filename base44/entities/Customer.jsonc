{
  "name": "Customer",
  "type": "object",
  "properties": {
    "company_name": {
      "type": "string",
      "description": "Business or customer name"
    },
    "contact_name": {
      "type": "string",
      "description": "Primary contact person"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "zip": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "service_company": {
      "type": "string",
      "description": "Which service company this customer belongs to"
    }
  },
  "required": [
    "company_name"
  ]
}