{
  "name": "Job",
  "type": "object",
  "properties": {
    "job_number": {
      "type": "string",
      "description": "Unique job number (e.g., J-2026-001)"
    },
    "customer_id": {
      "type": "string",
      "description": "Reference to customer"
    },
    "job_type": {
      "type": "string",
      "enum": [
        "service",
        "parts_only",
        "consultation"
      ],
      "default": "service",
      "description": "Type of job"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "completed",
        "invoiced",
        "closed"
      ],
      "default": "open",
      "description": "Overall job status"
    },
    "description": {
      "type": "string",
      "description": "Brief description of the job"
    },
    "service_company": {
      "type": "string",
      "description": "Which service company this job belongs to"
    }
  },
  "required": [
    "job_number",
    "customer_id"
  ]
}